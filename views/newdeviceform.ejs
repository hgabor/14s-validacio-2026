<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="post">
        <input type="number" name="price" value="<%= locals.body?.price %>">
        <label>
            <input type="radio" name="type" value="router"
                <%= locals.body?.type === 'router' ? 'checked' : '' %>
            >
            Router
        </label>
        <label>
            <input type="radio" name="type" value="switch"
                <%= locals.body?.type === 'switch' ? 'checked' : '' %>
            >
            Switch
        </label>
        <label>
            <input type="radio" name="type" value="firewall"
                <%= locals.body?.type === 'firewall' ? 'checked' : '' %>
            >
            Firewall
        </label>
        <input type="text" name="serial" value="<%= locals.body?.serial %>">

        <% if (locals.errors && locals.errors.length > 0) { %>
            <ul style="color: red">
                <% locals.errors.forEach(e => { %>
                    <li><%= e %></li>
                <% }) %>
            </ul>
        <% } %> 

        <button type="submit">Add new device</button>

        <% if (locals.success) { %>
            <p style="color: darkgreen">Device added!</p>
        <% } %>
    </form>
</body>
</html>